{
  "name": "matchside",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "probe": "tsx scripts/probe.ts",
    "record": "tsx scripts/record.ts",
    "cache:recorded": "tsx scripts/cache-recorded-answers.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "test:db": "node scripts/test-database.mjs",
    "fixtures": "tsx scripts/fixtures.ts",
    "smoke": "tsx scripts/smoke.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "26.x"
  }
}
