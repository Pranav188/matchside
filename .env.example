# Free accounts only. Copy to .env.local. Never commit credentials.
SPORTMONKS_API_TOKEN=
# Free leagues: Scottish Premiership (501), Danish Superliga (271).
SPORTMONKS_FIXTURE_ID=
GEMINI_API_KEY=
DATABASE_URL=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set these to the actual FREE quota shown in Google AI Studio. Zero disables AI.
GEMINI_FREE_RPD=0
GEMINI_FREE_RPM=0
GEMINI_FREE_TPM=0
GEMINI_MODEL=gemini-2.5-flash
# Optional backup account. One fallback is allowed for upstream rate limits, timeouts or outages.
# Each attempt consumes the same shared app/visitor allowance; adding a key does not raise it.
GEMINI_BACKUP_API_KEY=
# Enter this account's confirmed free limits separately. Zero leaves it unconfigured.
GEMINI_BACKUP_FREE_RPD=0
GEMINI_BACKUP_FREE_RPM=0
GEMINI_BACKUP_FREE_TPM=0
# Optional: path to an in-play snapshot captured by npm run record.
RECORDED_SNAPSHOT_PATH=data/recorded-match.json
