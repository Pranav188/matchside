# Free accounts only. Copy to .env.local. Never commit credentials.
SPORTMONKS_API_TOKEN=
# Free leagues: Scottish Premiership (501), Danish Superliga (271).
SPORTMONKS_FIXTURE_ID=
GEMINI_API_KEY=
DATABASE_URL=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set these to the actual FREE quota shown in Google AI Studio. Zero disables AI.
GEMINI_FREE_RPD=0
GEMINI_FREE_RPM=0
GEMINI_FREE_TPM=0
GEMINI_MODEL=gemini-2.5-flash
# Optional: path to an in-play snapshot captured by npm run record.
RECORDED_SNAPSHOT_PATH=data/recorded-match.json
